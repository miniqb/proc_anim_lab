<Project Sdk="Microsoft.NET.Sdk">
  <!-- 无引擎冒烟回归：纯 .NET console，不经 Godot 可执行文件直接驱动内核。
       跑法：在仓库根 `dotnet run` 加 `project core/smoke` 参数（退出码 0=PASS / 1=FAIL）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- TFM 跟随 Godot（net8.0）；宿主机只装更高版运行时（如 .NET 10）也能跑。 -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ProcAnim.Core.Smoke</RootNamespace>
    <AssemblyName>ProcAnim.Core.Smoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ProcAnim.Core.csproj" />
  </ItemGroup>
</Project>
