<Project Sdk="Microsoft.NET.Sdk">
  <!-- RatFiend 专项无引擎回归。只驱动 ProcAnim.Core，不加载 Godot 场景树。
       运行：dotnet run \-\-project core/ratfiend_smoke（0=PASS / 1=FAIL）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ProcAnim.Core.RatFiendSmoke</RootNamespace>
    <AssemblyName>ProcAnim.Core.RatFiendSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ProcAnim.Core.csproj" />
  </ItemGroup>
</Project>
